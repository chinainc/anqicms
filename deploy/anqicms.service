[Unit]
Description=AnqiCMS Go service (site + admin + api)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/anqicms

# 配置文件是程序目录下的 config.json（由 Web 安装向导 /install 生成）。
# 数据库连接也可以用环境变量覆盖（优先级高于 config.json）：
#   MYSQL_HOST / MYSQL_PORT / MYSQL_DATABASE / MYSQL_USER / MYSQL_ROOT_PASSWORD
# 开头的 - 表示文件不存在也不报错。
EnvironmentFile=-/etc/anqicms.env

ExecStart=/www/wwwroot/anqicms/anqicms
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15

# 启动失败时不要疯狂重启，方便排查配置/数据库问题
StartLimitIntervalSec=60
StartLimitBurst=5

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
